// .vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nim: build current file (for debugging)",
            "command": "nim",
            "args": [
                "compile",
                "-g",
                "--debugger:native",
                "--stackTrace:on",
                "--lineTrace:on",
                "--lineDir:on",
                "-d:useMalloc",
                "-d:deb",
                "-o:${workspaceRoot}/bin/${fileBasenameNoExtension}-dbg",
                "${relativeFile}"
            ],
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "type": "shell",
        }
    ]
}